rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NEU Library Security Rules
     * 
     * Core Philosophy: 
     * This ruleset implements a hybrid security model combining strict User-Ownership with 
     * Global Administrative overrides. 
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Allow any signed-in user (including anonymous terminal sessions) to lookup profiles by email
      allow get, list: if isSignedIn() || isAdmin();
      
      // Allow creation during registration. In a kiosk, users create their initial profile.
      allow create: if isSignedIn();
      
      // Only owners or admins can update profiles (e.g., blocking access)
      allow update: if (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      // Any signed-in user can check their own admin status
      allow get: if isSignedIn();
      allow list: if isAdmin();
      
      // Bootstrapping: Allow the designated admin email to create their own admin document
      // Management: Allow existing admins to manage administrative roles
      allow create: if (isSignedIn() && request.auth.token.email == 'jcesperanza@neu.edu.ph' && request.auth.uid == adminId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /purpose_of_visits/{purposeId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /visit_logs/{visitLogId} {
      // Visitors can create logs. Admins can do everything.
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin();
    }

  }
}