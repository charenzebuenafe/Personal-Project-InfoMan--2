rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NEU Library Security Rules
     * 
     * Core Philosophy: 
     * This ruleset implements a hybrid security model combining strict User-Ownership with 
     * Global Administrative overrides. 
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Allow any signed-in user to lookup profiles. Admins have full access.
      allow get, list: if isSignedIn() || isAdmin();
      
      // Allow creation during registration.
      allow create: if isSignedIn();
      
      // Only owners or admins can update profiles
      allow update: if (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      // Any signed-in user can check their own admin status
      allow get: if isSignedIn();
      allow list: if isAdmin();
      
      // ALLOW BOOTSTRAP: Allow an authenticated user to create their own admin doc 
      // IF they claim the primary admin email address.
      allow create: if (isSignedIn() && (
        request.auth.uid == adminId && (
          request.resource.data.email == 'jcesperanza@neu.edu.ph' || 
          request.auth.token.email == 'jcesperanza@neu.edu.ph'
        )
      )) || isAdmin();
      
      allow update, delete: if isAdmin();
    }

    match /purpose_of_visits/{purposeId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /visit_logs/{visitLogId} {
      // Visitors can create logs. Admins can do everything.
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin();
    }

  }
}