rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NEU Library Security Rules
     * 
     * Core Philosophy: 
     * This ruleset implements a hybrid security model combining strict User-Ownership with 
     * Global Administrative overrides. 
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Allow any signed-in user to lookup profiles (needed for the email check-in terminal)
      // In a production app, you might restrict the fields returned, but for this prototype, we allow list.
      allow get, list: if isSignedIn() || isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      // Any signed-in user can check if they are an admin
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /purpose_of_visits/{purposeId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /visit_logs/{visitLogId} {
      // Visitors can create logs. Admins can do everything.
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin();
    }

  }
}