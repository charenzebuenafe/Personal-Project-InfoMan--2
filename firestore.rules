rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NEU Library Security Rules
     * 
     * Core Philosophy: 
     * This ruleset implements a hybrid security model combining strict User-Ownership with 
     * Global Administrative overrides. It prioritizes "Authorization Independence" by using 
     * a dedicated marker collection for admin roles, ensuring that security checks are 
     * atomic and do not suffer from performance bottlenecks or deeply nested lookups.
     * 
     * Data Structure:
     * - /users/{userId}: Private user profiles and institutional identity.
     * - /roles_admin/{userId}: An existence-based collection defining administrative access.
     * - /purpose_of_visits/{id}: Publicly readable library visit categories.
     * - /visit_logs/{id}: Individual check-in records, optimized for admin reporting.
     * 
     * Key Security Decisions:
     * - Admin roles are determined by the existence of a document in the '/roles_admin' collection.
     * - Denormalization: Visit logs contain copies of user details (college, employee status) 
     *   to allow administrators to perform complex filtered queries (list operations) 
     *   without requiring expensive 'get()' calls inside security rules.
     * - Relational Integrity: On document creation, rules enforce that the internal 
     *   'userId' or 'id' fields match the authenticated user's UID to prevent data spoofing.
     */

    // --- Global Helper Functions ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** 
     * Checks if the user has administrative privileges. 
     * Uses the 'existence over content' pattern for high-performance authorization.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profile documents. Users manage their own profiles; admins manage access status.
     * @path /users/{userId}
     * @allow (get) If the user owns the profile or is an administrator.
     * @deny (create) If the internal 'id' field does not match the path's userId.
     * @principle Ownership-based access with administrative oversight and relational integrity.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) || isAdmin()) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Marker collection for admin roles. Determines who can view library statistics and manage users.
     * @path /roles_admin/{adminId}
     * @allow (get) Any authenticated user can check for admin status existence.
     * @deny (write) Any non-admin attempting to grant themselves privileges.
     * @principle Role-based access control (RBAC) via existence-based marker collections.
     */
    match /roles_admin/{adminId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description Predefined categories for visit reasons. Used by visitors during check-in.
     * @path /purpose_of_visits/{purposeId}
     * @allow (list) All authenticated users to select reasons for visiting.
     * @deny (write) General users attempting to modify library categories.
     * @principle Read-only public data for authenticated users; admin-only management.
     */
    match /purpose_of_visits/{purposeId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Individual logs of library visits. Includes denormalized data for admin filtering.
     * @path /visit_logs/{visitLogId}
     * @allow (create) Any signed-in user recording their own library visit.
     * @allow (list) Administrators performing statistical analysis and filtering.
     * @deny (read) A user attempting to read another user's visit history.
     * @principle Optimized for high-volume creation and administrative reporting via denormalized fields.
     */
    match /visit_logs/{visitLogId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

  }
}